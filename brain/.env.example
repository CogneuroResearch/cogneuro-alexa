# Which LLM to use: anthropic | openai
# Adding another means one file in llm/ and one line in llm/__init__.py.
LLM_PROVIDER=anthropic

# Only the key for the provider above is needed.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Only needed if your Anthropic key is scoped to the Organization rather
# than to a workspace. Console › Settings › Workspaces.
# ANTHROPIC_WORKSPACE_ID=

# Optional: override the provider's default model.
#   claude-haiku-4-5-20251001  fastest, cheapest — good for this workload
#   claude-sonnet-5            default; smarter, a second or two slower
# LLM_MODEL=claude-haiku-4-5-20251001

# Linear personal API key — Settings › Security & access › Personal API keys.
# Sent as the raw Authorization header, no "Bearer " prefix.
LINEAR_API_KEY=

# Set to 0 to disable prompt caching of the system prompt and tool schemas.
# PROMPT_CACHE=1

# Set to 0 to hide the "→ tool(...)" lines in chat.py
SHOW_TOOL_CALLS=1

# --- Pi-side speech (server.py only) --------------------------------------
# Whisper model. base.en measured at 0.33x realtime on a Pi 5; small.en at
# 0.9x and no more accurate, so base.en is the default.
# WHISPER_MODEL=base.en

# Piper voice — the .onnx file. Browse voices at:
#   https://huggingface.co/rhasspy/piper-voices
# PIPER_MODEL=/home/john/piper/en_GB-alba-medium.onnx

# Speaking rate: >1 slower, <1 faster. 1.0 is the voice's natural pace.
# PIPER_LENGTH_SCALE=1.0

# Speaker index, for multi-speaker voices such as en_US-libritts-high.
# PIPER_SPEAKER=

# Reset conversation history after this many idle seconds.
# IDLE_RESET_SECONDS=600

# Spoken immediately after Whisper finishes, to cover the LLM round trips.
# Pipe-separated, rotated between turns. Empty string disables.
# ACK_PHRASES=Okay.|Sure.|Right.

# Set to 1 to force the Piper CLI instead of loading the voice in-process.
# Only useful if the in-process path misbehaves — it is much slower.
# PIPER_USE_CLI=0
