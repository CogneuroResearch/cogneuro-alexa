# Shared secret the ESP32 must send as the X-Device-Key header on POST /api/capture.
# Generate one with:  openssl rand -hex 16
DEVICE_KEY=

# Optional. If set, the review page and listing/audio endpoints require HTTP Basic auth
# (any username, this string as the password). Ingest is unaffected.
VIEW_PASSWORD=

# Added automatically by Vercel when you create a Blob store and link it to the project.
# Only needed locally, for `next dev` against the real store.
BLOB_READ_WRITE_TOKEN=
